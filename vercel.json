{
  "crons": [
    {
      "path": "/api/cron/trial-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/follow-up-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/webhook-deliveries",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/context-sync",
      "schedule": "17 */3 * * *"
    }
  ],
  "ignoreCommand": "node -e \"const ref=process.env.VERCEL_GIT_COMMIT_REF||''; const msg=process.env.VERCEL_GIT_COMMIT_MESSAGE||''; const allow=!ref||ref==='main'||ref==='master'||ref.startsWith('preview/')||msg.includes('[vercel-preview]'); process.exit(allow?1:0)\""
}
